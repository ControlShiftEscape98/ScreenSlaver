import { useSessionStore } from '../../core/sessionManager';

// Placeholder for different skin components
const ModernDarkSkin = () => (
    <div className="w-full h-full bg-black text-white relative font-sans overflow-hidden">
        {/* Status Bar */}
        <div className="absolute top-0 w-full px-6 py-2 flex justify-between items-center text-sm font-medium z-50">
            <span>9:41</span>
            <div className="flex gap-2 items-center">
                <span>5G</span>
                <div className="w-6 h-3 border border-white rounded-[2px] relative">
                    <div className="absolute top-[2px] left-[2px] bottom-[2px] right-[4px] bg-white"></div>
                </div>
            </div>
        </div>

        {/* Wallpaper */}
        <div className="absolute inset-0 bg-gradient-to-b from-purple-900 to-black z-0 opacity-50"></div>

        {/* App Grid */}
        <div className="relative z-10 pt-20 px-6 grid grid-cols-4 gap-6">
            {[...Array(16)].map((_, i) => (
                <div key={i} className="flex flex-col items-center gap-1">
                    <div className="w-14 h-14 bg-neutral-700/80 rounded-2xl backdrop-blur-md"></div>
                    <span className="text-[10px] text-white/80">App</span>
                </div>
            ))}
        </div>

        {/* Dock */}
        <div className="absolute bottom-6 left-4 right-4 h-24 bg-white/10 backdrop-blur-xl rounded-[32px] flex items-center justify-around px-4">
            {[...Array(4)].map((_, i) => (
                <div key={i} className={`w-14 h-14 rounded-2xl ${['bg-green-500', 'bg-white', 'bg-blue-500', 'bg-gray-800'][i]}`}></div>
            ))}
        </div>
    </div>
);

export default function ReceiverView() {
    const { connected } = useSessionStore();

    if (!connected) {
        return (
            <div className="min-h-screen bg-black flex items-center justify-center text-neutral-500">
                <p>Connecting to neural link...</p>
            </div>
        );
    }

    return <ModernDarkSkin />;
}
