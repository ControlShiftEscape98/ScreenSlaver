import { connect } from "./shared.js";

window.startReceiverMode = function () {
  const code = prompt("Enter session code");
  const ws = connect();

  ws.onopen = () => {
    ws.send(JSON.stringify({ type: "JOIN_SESSION", code }));
    renderReceiver();
  };

  ws.onmessage = e => {
    const data = JSON.parse(e.data);
    if (data.type === "STATE_UPDATE") updateState(data);
    if (data.type === "FAKE_CALL") showCall();
  };
};

function renderReceiver() {
  document.getElementById("app").innerHTML = `
    <div class="phone">
      <div id="status"></div>
      <div id="screen">Idle</div>
    </div>
  `;
}

function updateState(data) {
  document.getElementById("status").innerText =
    `Battery: ${data.battery ?? "-"}% | Signal: ${data.signal ?? "-"}`;
}

function showCall() {
  document.getElementById("screen").innerHTML =
    "<h3>Incoming Call…</h3>";
}
