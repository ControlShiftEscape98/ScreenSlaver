import { connect } from "./shared.js";

window.startControllerMode = function () {
  const ws = connect();

  ws.onopen = () => {
    ws.send(JSON.stringify({ type: "CREATE_SESSION" }));
  };

  ws.onmessage = e => {
    const data = JSON.parse(e.data);
    if (data.type === "SESSION_CREATED") {
      renderController(ws, data.code);
    }
  };
};

function renderController(ws, code) {
  const app = document.getElementById("app");
  app.innerHTML = `
    <h2>Controller</h2>
    <p>Session Code: <b>${code}</b></p>

    <label>Battery</label>
    <input type="range" min="0" max="100" value="100"
      oninput="updateBattery(this.value)" />

    <label>Signal</label>
    <input type="range" min="0" max="4" value="4"
      oninput="updateSignal(this.value)" />

    <button onclick="fakeCall()">Trigger Fake Call</button>
  `;

  window.updateBattery = value =>
    ws.send(JSON.stringify({ type: "STATE_UPDATE", battery: value }));

  window.updateSignal = value =>
    ws.send(JSON.stringify({ type: "STATE_UPDATE", signal: value }));

  window.fakeCall = () =>
    ws.send(JSON.stringify({ type: "FAKE_CALL" }));
}
