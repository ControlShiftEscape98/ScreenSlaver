fixtureManager.js
class Fixture {
  constructor(deviceId, friendlyName, deviceType, capabilities) {
    this.deviceId = deviceId;
    this.friendlyName = friendlyName;
    this.deviceType = deviceType;
    this.capabilities = capabilities;
    this.state = {};        // battery, signal, call, text, etc.
    this.cueStack = [];     // queued cues
    this.group = null;
  }

  updateState(newState) {
    this.state = {...this.state, ...newState};
    // update UI / VFX layer if Receiver
  }
}

class FixtureManager {
  constructor() {
    this.fixtures = {};
  }

  addFixture(fixture) {
    this.fixtures[fixture.deviceId] = fixture;
  }

  getFixture(deviceId) {
    return this.fixtures[deviceId];
  }

  getGroup(groupName) {
    return Object.values(this.fixtures).filter(f => f.group === groupName);
  }
}
cueManager.js
class CueManager {
  constructor(fixtureManager) {
    this.fixtureManager = fixtureManager;
  }

  addCue(deviceId, cue) {
    this.fixtureManager.getFixture(deviceId).cueStack.push(cue);
  }

  triggerCue(deviceId, cueId) {
    let fixture = this.fixtureManager.getFixture(deviceId);
    let cue = fixture.cueStack.find(c => c.id === cueId);
    if(cue) {
      fixture.updateState(cue.parameters);
      cue.status = "fired";
      // send message to device if networked
    }
  }

  triggerGroup(groupName, cueId) {
    let group = this.fixtureManager.getGroup(groupName);
    group.forEach(device => this.triggerCue(device.deviceId, cueId));
  }
}
presetManager.js
class PresetManager {
  constructor(fixtureManager) {
    this.fixtureManager = fixtureManager;
  }

  loadPreset(preset) {
    // preset contains device states
    preset.devices.forEach(d => {
      let fixture = this.fixtureManager.getFixture(d.deviceId);
      if(fixture) fixture.updateState(d.parameters);
    });
  }
}
