/server/server.js
const WebSocket = require("ws");
const wss = new WebSocket.Server({ port: 3000 });

const sessions = {}; 
// sessions[code] = { controller: ws, receivers: [] }

function generateCode() {
  return Math.random().toString(36).substring(2, 7).toUpperCase();
}

wss.on("connection", ws => {
  ws.on("message", msg => {
    const data = JSON.parse(msg);

    if (data.type === "CREATE_SESSION") {
      const code = generateCode();
      sessions[code] = { controller: ws, receivers: [] };
      ws.sessionCode = code;
      ws.send(JSON.stringify({ type: "SESSION_CREATED", code }));
    }

    if (data.type === "JOIN_SESSION") {
      const session = sessions[data.code];
      if (!session) return;
      session.receivers.push(ws);
      ws.sessionCode = data.code;
    }

    if (data.type === "STATE_UPDATE") {
      const session = sessions[ws.sessionCode];
      if (!session) return;
      session.receivers.forEach(r =>
        r.send(JSON.stringify(data))
      );
    }

    if (data.type === "FAKE_CALL") {
      const session = sessions[ws.sessionCode];
      if (!session) return;
      session.receivers.forEach(r =>
        r.send(JSON.stringify({ type: "FAKE_CALL" }))
      );
    }
  });
});

console.log("Server running on ws://localhost:3000");
